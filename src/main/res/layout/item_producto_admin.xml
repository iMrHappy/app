<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical">

    <!-- Imagen categoría -->
    <ImageView
        android:id="@+id/ivProductoAdmin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp"
        android:background="#F5F5F5" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#28251D" />

        <TextView
            android:id="@+id/tvCategoriaAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#7A7974" />

        <TextView
            android:id="@+id/tvPrecioAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#01696F" />

    </LinearLayout>

    <Button
        android:id="@+id/btnEditar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="✏"
        android:textSize="14sp"
        android:backgroundTint="#E87722"
        android:textColor="#FFFFFF"
        android:padding="0dp"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/btnEliminar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="✕"
        android:textSize="14sp"
        android:backgroundTint="#A12C7B"
        android:textColor="#FFFFFF"
        android:padding="0dp" />

</LinearLayout>