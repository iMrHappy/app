<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6F2">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarLoginAdmin"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#01696F"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceso Administrador"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#28251D"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etUsuarioAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario"
            android:inputType="text"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPasswordAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contrasena"
            android:inputType="textPassword"
            android:padding="14dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnIngresarAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ingresar"
            android:backgroundTint="#01696F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</LinearLayout>