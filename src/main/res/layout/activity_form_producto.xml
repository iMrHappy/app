<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6F2">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#01696F"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/etNombreForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:inputType="text"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etCategoriaForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Categoria (Abarrotes, Limpieza, Plasticos, Ferreteria)"
            android:inputType="text"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPrecioForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio (ej: 3.50)"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etStockForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stock disponible"
            android:inputType="number"
            android:padding="14dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Guardar"
            android:backgroundTint="#01696F"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>